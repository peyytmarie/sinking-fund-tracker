rules_version = '2';

// Template: replace the placeholder email with the admin's Google account, then paste into
// Firebase console → Firestore → Rules and Publish. Keep the real email out of this public repo.
// Anyone with the link can read the fund; only the listed Google accounts can change it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /funds/{fundId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['your.email@gmail.com'];
    }
  }
}
